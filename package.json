{
  "private": true,
  "name": "innsikt-sales-hub-checks",
  "version": "0.9.2",
  "description": "Testverktøy for statisk Innsikt-portal. Ingen runtime-avhengigheter.",
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:browser": "node scripts/check-prompt-browser.mjs && node scripts/check-browser.mjs",
    "build:slide-download": "esbuild scripts/slide-download-entry.mjs --bundle --format=esm --platform=browser --target=es2020 --minify --legal-comments=eof --outfile=docs/assets/slide-download.js",
    "build:media": "python3 scripts/rebuild-media.py --rebuild",
    "check:media": "node scripts/check-media-assets.mjs",
    "build:artifact": "node scripts/package-artifact.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "html-to-image": "^1.11.13",
    "jspdf": "^3.0.3",
    "jszip": "^3.10.1",
    "playwright": "1.64.0",
    "pptxgenjs": "^3.12.0"
  }
}
